{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "candle-motion-project/v2",
  "title": "Image-agnostic scene project (candles legacy compatible)",
  "description": "Projet local versionné pour l’éditeur de scène par éléments. Compatible avec le cas bougies historique ; ne décrit ni une entrée moteur LTX ni un export.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "version",
    "status",
    "approval",
    "label",
    "artistIntent",
    "previewSettings",
    "engineControls",
    "source",
    "workingSpace",
    "camera",
    "loop",
    "protection",
    "seed",
    "groups",
    "regions",
    "presets",
    "proposals"
  ],
  "properties": {
    "schema": { "const": "candle-motion-project/v2" },
    "id": { "type": "string", "minLength": 3 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "enum": ["diagnostic-not-approved", "provisional", "approved-preview"] },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source", "note"],
      "properties": {
        "status": { "enum": ["not-approved", "approved"] },
        "source": { "type": "string", "minLength": 3 },
        "note": { "type": "string", "minLength": 3 }
      }
    },
    "label": { "const": "Motion intention preview—not a prediction of AI output." },
    "artistIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "constraints", "nonGoals"],
      "properties": {
        "summary": { "type": "string", "minLength": 10 },
        "constraints": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
        "nonGoals": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } }
      }
    },
    "previewSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preset", "showRegions", "playbackRate", "note"],
      "properties": {
        "preset": { "type": "string", "minLength": 2 },
        "showRegions": { "type": "boolean" },
        "playbackRate": { "type": "number", "exclusiveMinimum": 0 },
        "compare": { "type": "boolean" },
        "compareSplit": { "type": "number", "minimum": 0.05, "maximum": 0.95 },
        "note": { "type": "string", "minLength": 3 }
      }
    },
    "engineControls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conditioningSignals", "note"],
      "properties": {
        "conditioningSignals": {
          "type": "array",
          "description": "Doit rester vide : une annotation de ce projet n’est pas un signal LTX.",
          "maxItems": 0,
          "items": { "type": "string" }
        },
        "note": { "type": "string", "minLength": 10 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256", "width", "height", "colorSpace", "role"],
      "properties": {
        "id": { "type": "string", "minLength": 3 },
        "path": { "type": "string", "minLength": 3 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "colorSpace": { "type": "string", "minLength": 3 },
        "role": { "enum": ["diagnostic-background", "local-import", "concept-sheet-crop"] }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "aspectRatio": { "type": "string", "minLength": 3 },
        "fps": { "type": "integer", "minimum": 1 },
        "colorSpace": { "type": "string", "minLength": 3 },
        "audio": { "enum": ["none", "requested"] },
        "status": { "enum": ["unresolved", "defined", "verified"] }
      }
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceImage": { "enum": ["not-reviewed", "approved", "rejected"] },
        "imagePreparation": { "enum": ["not-reviewed", "approved", "rejected", "not-required"] },
        "preview": { "enum": ["not-reviewed", "approved", "rejected"] },
        "duration": { "enum": ["not-approved", "approved"] },
        "output": { "enum": ["unresolved", "approved", "rejected"] }
      }
    },
    "workingSpace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "decode", "encode", "highlight", "note"],
      "properties": {
        "name": { "const": "linear-sRGB" },
        "decode": { "type": "string", "minLength": 3 },
        "encode": { "type": "string", "minLength": 3 },
        "highlight": { "type": "string", "minLength": 3 },
        "note": { "type": "string", "minLength": 10 }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "catalogId", "note"],
      "properties": {
        "mode": { "const": "fixed" },
        "catalogId": { "const": "A-01" },
        "note": { "type": "string", "minLength": 3 }
      }
    },
    "loop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durationSeconds", "fps", "samples", "endpoint", "boundaryTolerance", "phaseRule", "note"],
      "properties": {
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "fps": { "type": "integer", "minimum": 1 },
        "samples": { "type": "integer", "minimum": 2 },
        "endpoint": { "const": "exclusive" },
        "boundaryTolerance": { "const": 0 },
        "phaseRule": { "type": "string", "minLength": 3 },
        "note": { "type": "string", "minLength": 3 }
      }
    },
    "protection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition", "overlapPolicy", "edgePolicy"],
      "properties": {
        "definition": { "type": "string", "minLength": 10 },
        "overlapPolicy": { "type": "string", "minLength": 10 },
        "edgePolicy": { "type": "string", "minLength": 10 }
      }
    },
    "seed": { "type": "integer" },
    "groups": {
      "type": "array",
      "minItems": 0,
      "items": { "$ref": "#/$defs/group" }
    },
    "regions": {
      "type": "array",
      "minItems": 0,
      "items": { "$ref": "#/$defs/region" }
    },
    "presets": {
      "type": "array",
      "minItems": 0,
      "items": { "$ref": "#/$defs/preset" }
    },
    "proposals": {
      "type": "array",
      "items": { "$ref": "#/$defs/proposal" }
    },
    "atmosphere": { "$ref": "#/$defs/atmosphere" }
  },
  "$defs": {
    "normalized": { "type": "number", "minimum": 0, "maximum": 1 },
    "positiveNormalized": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
    "point": {
      "type": "array",
      "prefixItems": [{ "$ref": "#/$defs/normalized" }, { "$ref": "#/$defs/normalized" }],
      "minItems": 2,
      "maxItems": 2
    },
    "polygon": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/point" }
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x0", "y0", "x1", "y1"],
      "properties": {
        "x0": { "$ref": "#/$defs/normalized" },
        "y0": { "$ref": "#/$defs/normalized" },
        "x1": { "$ref": "#/$defs/normalized" },
        "y1": { "$ref": "#/$defs/normalized" }
      }
    },
    "circle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "rx", "ry"],
      "properties": {
        "x": { "$ref": "#/$defs/normalized" },
        "y": { "$ref": "#/$defs/normalized" },
        "rx": { "$ref": "#/$defs/positiveNormalized" },
        "ry": { "$ref": "#/$defs/positiveNormalized" }
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "points"],
      "properties": {
        "type": { "const": "polygon" },
        "points": { "$ref": "#/$defs/polygon" },
        "extraRects": { "type": "array", "items": { "$ref": "#/$defs/rect" } },
        "extraCircles": { "type": "array", "items": { "$ref": "#/$defs/circle" } }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "flame": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "amplitude": { "type": "number", "minimum": 0, "maximum": 0.5 },
            "harmonic": { "type": "integer", "minimum": 1, "maximum": 4 },
            "lean": { "type": "number", "minimum": 0, "maximum": 0.6 },
            "windResponse": { "type": "number", "minimum": 0, "maximum": 2 }
          }
        },
        "lightScale": { "type": "number", "exclusiveMinimum": 0, "maximum": 3 },
        "lightModulation": { "type": "number", "minimum": 0, "maximum": 1 },
        "intensity": { "type": "number", "minimum": 0, "maximum": 2 },
        "wind": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "direction": { "type": "number", "minimum": 0, "maximum": 360 },
            "strength": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "variation": { "enum": ["synchronized", "correlated", "independent"] }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "phase"],
      "properties": {
        "action": { "enum": ["flame-shape", "warm-pool", "none"] },
        "phase": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "label", "supportStatus", "support", "motion", "render", "notes", "groupId", "category", "operation", "overrides"],
      "properties": {
        "id": { "type": "string", "pattern": "^(flame|light|region)\\.[a-z0-9-]+$" },
        "role": { "enum": ["animated", "light-influence", "protected"] },
        "category": { "enum": ["flame", "light", "other", "foliage", "fabric"] },
        "groupId": { "type": "string", "pattern": "^group\\.[a-z0-9-]+$" },
        "label": { "type": "string", "minLength": 3 },
        "supportStatus": { "enum": ["declared", "visually-checked"] },
        "support": { "$ref": "#/$defs/support" },
        "operation": { "enum": ["animate", "protect", "transform"] },
        "recipe": { "enum": ["protect", "candle-flame", "candle-light", "foliage", "fabric", "camera-transform"] },
        "animationEnabled": { "type": "boolean" },
        "transformPlan": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "description"],
          "properties": {
            "status": { "const": "proposed" },
            "description": { "type": "string" },
            "operations": { "type": "array", "items": { "type": "string" } }
          }
        },
        "overrides": { "$ref": "#/$defs/settings" },
        "size": { "type": "number", "minimum": 0.25, "maximum": 3 },
        "anchor": { "$ref": "#/$defs/point" },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "center": { "$ref": "#/$defs/point" },
        "radii": {
          "type": "array",
          "prefixItems": [
            { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "sources": {
          "type": "array",
          "items": { "type": "string", "pattern": "^flame\\.[a-z0-9-]+$" }
        },
        "motion": { "$ref": "#/$defs/motion" },
        "render": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "workingSpace"],
          "properties": {
            "method": { "enum": ["procedural-flame-v1", "local-warm-pool-v1", "none"] },
            "workingSpace": { "const": "linear" },
            "suppression": { "type": "number", "minimum": 0, "maximum": 1 },
            "gain": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.5 },
            "color": {
              "type": "array",
              "prefixItems": [
                { "type": "number", "minimum": 0, "maximum": 1 },
                { "type": "number", "minimum": 0, "maximum": 1 },
                { "type": "number", "minimum": 0, "maximum": 1 }
              ],
              "minItems": 3,
              "maxItems": 3
            },
            "falloff": { "type": "number", "exclusiveMinimum": 0, "maximum": 5 }
          },
          "allOf": [
            {
              "if": { "properties": { "method": { "const": "procedural-flame-v1" } } },
              "then": { "required": ["suppression"] }
            },
            {
              "if": { "properties": { "method": { "const": "local-warm-pool-v1" } } },
              "then": { "required": ["gain", "color", "falloff"] }
            }
          ]
        },
        "notes": { "type": "string", "minLength": 3 }
      },
      "allOf": [
        {
          "if": { "properties": { "role": { "const": "animated" } } },
          "then": { "required": ["anchor", "height", "width", "size"] }
        },
        {
          "if": { "properties": { "role": { "const": "light-influence" } } },
          "then": { "required": ["center", "radii", "sources"] }
        }
      ]
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "category", "elementIds", "animationEnabled", "settings"],
      "properties": {
        "id": { "type": "string", "pattern": "^group\\.[a-z0-9-]+$" },
        "label": { "type": "string", "minLength": 2 },
        "category": { "enum": ["candles", "foliage", "fabric", "generic"] },
        "elementIds": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "presetId": { "type": "string", "minLength": 2 },
        "presetVersion": { "type": "integer", "minimum": 1 },
        "animationEnabled": { "type": "boolean" },
        "settings": { "$ref": "#/$defs/settings" }
      }
    },
    "preset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "version", "category", "flame", "lightScale", "lightModulation", "intensity", "wind", "variation"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "label": { "type": "string", "minLength": 3 },
        "note": { "type": "string" },
        "default": { "type": "boolean" },
        "version": { "type": "integer", "minimum": 1 },
        "category": { "enum": ["candles", "foliage", "fabric"] },
        "flame": {
          "type": "object",
          "additionalProperties": false,
          "required": ["amplitude", "harmonic", "lean", "windResponse"],
          "properties": {
            "amplitude": { "type": "number", "minimum": 0, "maximum": 0.5 },
            "harmonic": { "type": "integer", "minimum": 1, "maximum": 4 },
            "lean": { "type": "number", "minimum": 0, "maximum": 0.6 },
            "windResponse": { "type": "number", "minimum": 0, "maximum": 2 }
          }
        },
        "lightScale": { "type": "number", "exclusiveMinimum": 0, "maximum": 3 },
        "lightModulation": { "type": "number", "minimum": 0, "maximum": 1 },
        "intensity": { "type": "number", "minimum": 0, "maximum": 2 },
        "wind": {
          "type": "object",
          "additionalProperties": false,
          "required": ["direction", "strength"],
          "properties": {
            "direction": { "type": "number", "minimum": 0, "maximum": 360 },
            "strength": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "variation": { "enum": ["synchronized", "correlated", "independent"] }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "label", "support", "confidence", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^proposal\\.[a-z0-9-]+$" },
        "category": { "enum": ["flame", "light", "other"] },
        "label": { "type": "string", "minLength": 2 },
        "support": { "$ref": "#/$defs/support" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "status": { "enum": ["proposed", "confirmed", "rejected"] },
        "notes": { "type": "string" },
        "confirmedElementId": { "type": "string" },
        "uncertainty": { "type": "string" }
      }
    },
    "atmosphere": {
      "type": "object",
      "description": "Calque optionnel de variante B. Le support de la région référencée borne toutes les écritures.",
      "additionalProperties": false,
      "required": ["enabled", "regionId", "intensity", "cycles", "stars", "coolLight", "note"],
      "properties": {
        "enabled": { "type": "boolean" },
        "regionId": { "type": "string", "pattern": "^region\\.[a-z0-9-]+$" },
        "intensity": { "type": "number", "minimum": 0, "maximum": 1 },
        "cycles": { "type": "integer", "minimum": 1, "maximum": 3 },
        "stars": { "type": "boolean" },
        "coolLight": { "type": "boolean" },
        "coolLightRegionId": { "type": "string", "pattern": "^region\\.[a-z0-9-]+$" },
        "note": { "type": "string", "minLength": 10 }
      }
    }
  }
}
